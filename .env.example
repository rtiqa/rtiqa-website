# =====================================================================
# RTIQA Education Platform - Environment Configuration Template
# All secret credentials must be provided via platform secrets or deployment env.
# NEVER commit actual passwords, secrets, or private keys to git.
# =====================================================================

# =====================================================================
# 1. LOCAL DEVELOPMENT & DOCKER COMPOSE CONFIGURATION
# (Defaults configured to connect directly to local PostgreSQL & MinIO services)
# =====================================================================

# Local Database Connection (PostgreSQL 16 via Docker Compose)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rtiqa_db?sslmode=disable"

# Discrete PostgreSQL Parameters (Fallback if DATABASE_URL is not provided)
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="rtiqa_db"
PGSSLMODE="disable"
PGMAX_POOL="20"

# Local Authentication Secret (Minimum 32 characters for HMAC-SHA256 signing)
AUTH_SECRET="local_dev_jwt_hmac_secret_key_32bytes_minimum_length"

# Local Object Storage (MinIO S3-Compatible Storage via Docker Compose)
STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="rtiqa-storage"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin_local_secret"
S3_FORCE_PATH_STYLE="true"
STORAGE_URL_TTL="900"

# Local Development Server Settings
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Local / Dev SMTP Settings (Optional - fallback to console simulation in dev)
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Rtiqa Platform <no-reply@rtiqa.com>"

# Local MinIO Credentials for Docker Compose Environment
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin_local_secret"


# =====================================================================
# 2. PRODUCTION INFRASTRUCTURE CONFIGURATION (PLACEHOLDERS ONLY)
# (In production, supply values via Cloud Run / AWS ECS / Kubernetes Secrets)
# =====================================================================

# Production Managed PostgreSQL (Neon / Supabase / RDS / Cloud SQL)
# Must use SSL (sslmode=require) and strong authenticated credentials.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# PGHOST=""
# PGPORT="5432"
# PGUSER=""
# PGPASSWORD=""
# PGDATABASE=""
# PGSSLMODE="require"
# PGMAX_POOL="30"

# Production Authentication Secret (64+ character cryptographically random string)
# AUTH_SECRET=""

# Production Object Storage (AWS S3 / Cloudflare R2 / Google Cloud Storage S3 API)
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT="" # Leave empty for standard AWS S3; specify for Cloudflare R2 / GCP S3 API
# S3_REGION="eu-central-1"
# S3_BUCKET="rtiqa-production-storage"
# S3_ACCESS_KEY_ID="" # Leave empty if utilizing Cloud Container IAM Roles / Workload Identity
# S3_SECRET_ACCESS_KEY="" # Leave empty if utilizing Cloud Container IAM Roles / Workload Identity
# S3_FORCE_PATH_STYLE="false"
# STORAGE_URL_TTL="900" # 15 minutes presigned URL expiration

# Production Application Settings
# NODE_ENV="production"
# PORT="3000"
# APP_URL="https://rtiqa.com"

# AI & Integrations (Configured via Secrets Panel)
# GEMINI_API_KEY=""
# FORM_WEBHOOK_URL=""
# CONTACT_NOTIFICATION_EMAIL="contact@rtiqa.com"
