# =====================================================================
# RTIQA Education Platform - Environment Configuration Template
# All secret credentials must be provided via platform secrets or deployment env.
# NEVER commit actual passwords or private keys to git.
# =====================================================================

# --- Database Configuration (PostgreSQL 16+) ---
# Standard connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=prefer
DATABASE_URL=""

# Discrete PostgreSQL connection parameters (used if DATABASE_URL is not provided)
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="rtiqa_db"
PGSSLMODE="prefer"
PGMAX_POOL="20"

# --- Security & Authentication ---
# Cryptographic secret key for signing HMAC-SHA256 user authentication tokens
AUTH_SECRET=""

# --- Application Runtime & Hosting ---
NODE_ENV="production"
PORT="3000"
APP_URL=""

# --- AI & Extensions (Configured via Secrets Panel) ---
GEMINI_API_KEY=""

# --- Webhooks & Integrations ---
FORM_WEBHOOK_URL=""
CONTACT_NOTIFICATION_EMAIL="contact@rtiqa.com"
